{
  "name": "dbee",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter './apps/*' dev",
    "build": "bun run --filter '@dbee/web' build && bun run --filter '@dbee/server' build",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "eslint .",
    "test": "bun test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.69.0"
  }
}
